<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="J.A.R.V.I.S. / AI CONTROL CENTER" android:textColor="@color/white"
            android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Pilih provider → endpoint & model otomatis"
            android:textColor="@color/text_dim" android:layout_marginTop="4dp"/>

        <AutoCompleteTextView android:id="@+id/spPreset"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:hint="Provider — tap untuk memilih"
            android:textColor="@color/white" android:textColorHint="@color/text_dim"
            android:background="@drawable/bg_input" android:padding="12dp"
            android:layout_marginTop="14dp"/>

        <EditText android:id="@+id/etKey"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:hint="API key — paste langsung dari Notes"
            android:inputType="textPassword"
            android:textColor="@color/white" android:textColorHint="@color/text_dim"
            android:background="@drawable/bg_input" android:padding="12dp"
            android:layout_marginTop="10dp"/>

        <EditText android:id="@+id/etUrl"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:hint="Base URL (otomatis)"
            android:inputType="textUri" android:textColor="@color/white"
            android:textColorHint="@color/text_dim" android:background="@drawable/bg_input"
            android:padding="12dp" android:layout_marginTop="10dp"/>

        <AutoCompleteTextView android:id="@+id/etModel"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:hint="Model — tap untuk daftar model"
            android:textColor="@color/white" android:textColorHint="@color/text_dim"
            android:background="@drawable/bg_input" android:padding="12dp"
            android:layout_marginTop="10dp"/>

        <TextView android:id="@+id/tvConfigStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Masukkan API key lalu validasi."
            android:textColor="@color/text_dim" android:textSize="13sp"
            android:paddingTop="8dp" android:paddingBottom="2dp"/>

        <Button android:id="@+id/btnTest"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:text="⚡ VALIDATE &amp; LOAD MODELS"
            android:layout_marginTop="8dp"/>

        <Button android:id="@+id/btnRefreshModels"
            android:layout_width="match_parent" android:layout_height="46dp"
            android:text="↻ REFRESH MODEL LIST"
            android:layout_marginTop="6dp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swSpeak"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🔊 Auto voice" android:textColor="@color/white" android:layout_marginTop="18dp"/>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swFallback"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📴 Offline fallback" android:textColor="@color/white"/>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swBio"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🔐 Biometric lock" android:textColor="@color/white"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="TELEGRAM BOT" android:textColor="@color/white"
            android:textStyle="bold" android:layout_marginTop="22dp"/>
        <EditText android:id="@+id/etTelegramToken"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:hint="Bot token" android:inputType="textPassword"
            android:textColor="@color/white" android:background="@drawable/bg_input" android:padding="12dp"/>
        <EditText android:id="@+id/etTelegramAllow"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:hint="Allowlist chat ID (pisahkan koma)"
            android:textColor="@color/white" android:background="@drawable/bg_input" android:padding="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="WHATSAPP CLOUD API" android:textColor="@color/white"
            android:textStyle="bold" android:layout_marginTop="18dp"/>
        <EditText android:id="@+id/etWhatsappToken"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:hint="Access token" android:inputType="textPassword"
            android:textColor="@color/white" android:background="@drawable/bg_input" android:padding="12dp"/>
        <EditText android:id="@+id/etWhatsappPhone"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:hint="Phone Number ID" android:textColor="@color/white"
            android:background="@drawable/bg_input" android:padding="12dp"/>
        <EditText android:id="@+id/etWhatsappAllow"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:hint="Allowlist number/ID" android:textColor="@color/white"
            android:background="@drawable/bg_input" android:padding="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="WhatsApp inbound membutuhkan webhook publik; token disimpan lokal."
            android:textColor="@color/text_dim" android:paddingTop="6dp"/>

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="💾 SIMPAN SEMUA" android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"/>
    </LinearLayout>
</ScrollView>

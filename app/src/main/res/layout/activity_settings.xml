textColorHint="@color/text_dim" android:background="@drawable/bg_input" android:padding="12dp" android:layout_marginTop="8dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/btnSaveProfile" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="💾 Save Profile"/><Button android:id="@+id/btnNewProfile" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="＋ New"/><Button android:id="@+id/btnDeleteProfile" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="🗑 Delete"/></LinearLayout><Button android:id="@+id/btnTest" android:layout_width="match_parent" android:layout_height="48dp" android:text="⚡ TEST ACTIVE PROFILE"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AGENT WORKSPACE" android:textColor="@color/white" android:textStyle="bold" android:layout_marginTop="22dp"/><Button android:id="@+id/btnPersona" android:layout_width="match_parent" android:layout_height="48dp" android:text="🧠 Edit memory.md / soul.md / rules.md"/><Button android:id="@+id/btnTools" android:layout_width="match_parent" android:layout_height="48dp" android:text="🧩 Tool Builder"/><Button android:id="@+id/btnWebTools" android:layout_width="match_parent" android:layout_height="48dp" android:text="🌐 Web Tools — Search / News / Images / Scrape"/><Button android:id="@+id/btnAppAccess" android:layout_width="match_parent" android:layout_height="48dp" android:text="📱 App Access — daftar &amp; izin per aplikasi"/><Button android:id="@+id/btnAccessibility" android:layout_width="match_parent" android:layout_height="48dp" android:text="🖱️ Enable UI Control (Accessibility)"/><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="👑 Allow root-agent mode (device must actually be rooted)" android:textColor="@color/white"/>

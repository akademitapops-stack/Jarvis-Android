<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#02070D">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:background="#030C14" app:titleTextColor="#EAF7FF" app:subtitleTextColor="#6F8BA1" android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout android:id="@+id/topStatus" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:background="#06131F" app:layout_constraintTop_toBottomOf="@id/toolbar">
        <TextView android:id="@+id/tvStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="● USER | loading..." android:textColor="#58DFAE" android:textSize="10sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/coreState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EARTH NETWORK · IDLE" android:textColor="#6FE3FF" android:textSize="9sp" android:fontFamily="monospace"/>
    </LinearLayout>
    <com.hermes.jarvis.ui.DigitalEarthView android:id="@+id/digitalEarth" android:layout_width="match_parent" android:layout_height="235dp" android:layout_margin="10dp" android:background="#03101D" app:layout_constraintTop_toBottomOf="@id/topStatus"/>
    <TextView android:id="@+id/coreTelemetry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NETWORK  •  CORE ONLINE\nMODEL  •  ACTIVE\nLATENCY •  — ms" android:textColor="#5C8098" android:textSize="9sp" android:fontFamily="monospace" android:gravity="end" android:padding="8dp" android:background="#03121FB0" app:layout_constraintTop_toTopOf="@id/digitalEarth" app:layout_constraintEnd_toEndOf="@id/digitalEarth"/>
    <HorizontalScrollView android:id="@+id/quickScroll" android:layout_width="match_parent" android:layout_height="50dp" android:scrollbars="none" android:background="#030C14" app:layout_constraintTop_toBottomOf="@id/digitalEarth">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingHorizontal="6dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/quickNew" android:layout_width="wrap_content" android:layout_height="40dp" android:text="＋ Chat" style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/quickSessions" android:layout_width="wrap_content" android:layout_height="40dp" android:text="☰ Chats" style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnMode" android:layout_width="wrap_content" android:layout_height="40dp" android:text="⚡ Agent" style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/quickImage" android:layout_width="wrap_content" android:layout_height="40dp" android:text="✨ Image" style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/quickWeb" android:layout_width="wrap_content" android:layout_height="40dp" android:text="🌐 Web" style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/quickDashboard" android:layout_width="wrap_content" android:layout_height="40dp" android:text="📊" style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/quickVision" android:layout_width="wrap_content" android:layout_height="40dp" android:text="📷" style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/quickSkills" android:layout_width="wrap_content" android:layout_height="40dp" android:text="🧩" style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/quickLogs" android:layout_width="wrap_content" android:layout_height="40dp" android:text="🧾" style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/quickSettings" android:layout_width="wrap_content" android:layout_height="40dp" android:text="⚙ AI" style="@style/Widget.MaterialComponents.Button.TextButton"/>
        </LinearLayout>
    </HorizontalScrollView>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChat" android:layout_width="match_parent" android:layout_height="0dp" android:padding="10dp" android:clipToPadding="false" app:layout_constraintTop_toBottomOf="@id/quickScroll" app:layout_constraintBottom_toTopOf="@id/inputBar"/>
    <LinearLayout android:id="@+id/inputBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp" android:gravity="center_vertical" android:background="#030C14" app:layout_constraintBottom_toBottomOf="parent">
        <ImageButton android:id="@+id/btnMic" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_mic" android:background="?attr/selectableItemBackgroundBorderless" app:tint="#6FE3FF" android:contentDescription="Mic"/>
        <EditText android:id="@+id/etInput" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:hint="Talk to JARVIS…" android:textColorHint="#6F8BA1" android:textColor="#EAF7FF" android:fontFamily="monospace" android:textSize="13sp" android:background="@drawable/bg_input" android:padding="12dp" android:maxLines="4" android:inputType="textMultiLine|textNoSuggestions" android:imeOptions="actionSend"/>
        <ImageButton android:id="@+id/btnSend" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_send" android:background="?attr/selectableItemBackgroundBorderless" app:tint="#2499FF" android:contentDescription="Kirim"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

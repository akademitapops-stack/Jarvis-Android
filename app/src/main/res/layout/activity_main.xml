<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark">
<androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/surface" app:titleTextColor="@color/white" app:subtitleTextColor="@color/text_dim" android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" app:layout_constraintTop_toTopOf="parent"/>
<TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="7dp" android:paddingStart="14dp" android:textSize="11sp" android:fontFamily="monospace" android:background="@color/surface" android:text="● loading..." app:layout_constraintTop_toBottomOf="@id/toolbar"/>
<HorizontalScrollView android:id="@+id/quickScroll" android:layout_width="match_parent" android:layout_height="52dp" android:scrollbars="none" android:background="@color/surface2" app:layout_constraintTop_toBottomOf="@id/tvStatus">
<LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingHorizontal="8dp">
<com.google.android.material.button.MaterialButton android:id="@+id/quickDashboard" android:layout_width="wrap_content" android:layout_height="40dp" android:text="📊 Dashboard" style="@style/Widget.MaterialComponents.Button.TextButton"/>
<com.google.android.material.button.MaterialButton android:id="@+id/quickVision" android:layout_width="wrap_content" android:layout_height="40dp" android:text="📷 Vision" style="@style/Widget.MaterialComponents.Button.TextButton"/>
<com.google.android.material.button.MaterialButton android:id="@+id/quickSkills" android:layout_width="wrap_content" android:layout_height="40dp" android:text="🧩 Skills" style="@style/Widget.MaterialComponents.Button.TextButton"/>
<com.google.android.material.button.MaterialButton android:id="@+id/quickLogs" android:layout_width="wrap_content" android:layout_height="40dp" android:text="🧾 Logs" style="@style/Widget.MaterialComponents.Button.TextButton"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnMode" android:layout_width="wrap_content" android:layout_height="40dp" android:text="⚡ AGENT" style="@style/Widget.MaterialComponents.Button.TextButton"/> <com.google.android.material.button.MaterialButton android:id="@+id/quickSettings" android:layout_width="wrap_content" android:layout_height="40dp" android:text="⚙️ AI" style="@style/Widget.MaterialComponents.Button.TextButton"/>
</LinearLayout></HorizontalScrollView>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChat" android:layout_width="match_parent" android:layout_height="0dp" android:padding="8dp" android:clipToPadding="false" app:layout_constraintTop_toBottomOf="@id/quickScroll" app:layout_constraintBottom_toTopOf="@id/inputBar"/>
<LinearLayout android:id="@+id/inputBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp" android:gravity="center_vertical" android:background="@color/surface" app:layout_constraintBottom_toBottomOf="parent">
<ImageButton android:id="@+id/btnMic" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_mic" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/accent" android:contentDescription="Mic"/>
<EditText android:id="@+id/etInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Bicara ke Jarvis..." android:textColorHint="@color/text_dim" android:textColor="@color/white" android:fontFamily="monospace" android:textSize="14sp" android:background="@drawable/bg_input" android:padding="12dp" android:maxLines="4" android:inputType="textMultiLine|textNoSuggestions" android:imeOptions="actionSend"/>
<ImageButton android:id="@+id/btnSend" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_send" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/primary" android:contentDescription="Kirim"/>
</LinearLayout></androidx.constraintlayout.widget.ConstraintLayout>

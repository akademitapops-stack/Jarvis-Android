<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📷 JARVIS VISION"
        android:textColor="#64FFDA"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Butuh model vision: Gemini 1.5 Flash (gratis), GPT-4o, atau Llama-4"
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />

    <ImageView
        android:id="@+id/ivPhoto"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:scaleType="fitCenter"
        android:background="@drawable/bg_msg_term"
        android:layout_marginTop="12dp"
        android:contentDescription="Foto" />

    <EditText
        android:id="@+id/etQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Pertanyaan tentang foto..."
        android:textColor="@color/white"
        android:textColorHint="@color/text_dim"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnShoot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📸 JEPRET"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔍 ANALISA"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ambil foto lalu ketuk ANALISA."
            android:textColor="@color/white"
            android:textSize="14sp" />
    </ScrollView>
</LinearLayout>
